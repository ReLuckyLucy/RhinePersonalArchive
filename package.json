{
  "name": "rhine-personal-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/patch-rolling-number.mjs",
    "build": "tsc --noEmit && vite build",
    "dev": "node server/main.ts --dev",
    "start": "node scripts/start-local.mjs --open",
    "stop": "node scripts/stop-local.mjs",
    "test": "node --test tests/integration/*.test.ts",
    "test:e2e": "node scripts/test-browser.mjs",
    "setup": "node scripts/setup.mjs",
    "package:source": "node scripts/package-release.mjs source",
    "package:windows": "node scripts/package-release.mjs windows",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "0.4.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "docx": "9.5.1",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "tar-stream": "3.2.2",
    "tesseract.js": "7.0.0",
    "three": "0.183.2",
    "zod": "4.6.7",
    "playwright": "1.64.1",
    "@napi-rs/canvas": "1.0.11"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/tar-stream": "3.1.4",
    "@types/three": "0.183.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "description": "Local-first personal dossier, evidence and resume workspace with the Rhine wave interface",
  "license": "MIT"
}
